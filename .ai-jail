# ai-jail sandbox configuration
# https://github.com/akitaonrails/ai-jail
# Edit freely. Regenerate with: ai-jail --clean --init

command = [
    "claude",
    "--output-format",
    "json",
    "-p",
    "--dangerously-skip-permissions",
]
rw_maps = [
    "~/Projects/tasks/daedalus/bugs:~/.daedalus/worktrees/daedalus/issue-mask-home-claude/backlog/bugs",
    "~/Projects/tasks/daedalus:~/.daedalus/worktrees/daedalus/issue-mask-home-claude/.daedalus-folders/daedalus",
    "~/Projects/tasks/daedalus/bugs:~/.daedalus/worktrees/daedalus/issue-pi-fix/backlog/bugs",
    "~/Projects/tasks/daedalus:~/.daedalus/worktrees/daedalus/issue-pi-fix/.daedalus-folders/daedalus",
    "~/Projects/tasks/daedalus/bugs:~/.daedalus/worktrees/daedalus/issue-opencode-provider/backlog/bugs",
    "~/Projects/tasks/daedalus:~/.daedalus/worktrees/daedalus/issue-opencode-provider/.daedalus-folders/daedalus",
    "~/Projects/tasks/daedalus/bugs:~/.daedalus/worktrees/daedalus/issue-init-subcommands/backlog/bugs",
    "~/Projects/tasks/daedalus:~/.daedalus/worktrees/daedalus/issue-init-subcommands/.daedalus-folders/daedalus",
    "~/Projects/tasks/daedalus/bugs:~/.daedalus/worktrees/daedalus/issue-bug-fix-2/backlog/bugs",
    "~/Projects/tasks/daedalus:~/.daedalus/worktrees/daedalus/issue-bug-fix-2/.daedalus-folders/daedalus",
    "~/Projects/tasks/daedalus/bugs:~/.daedalus/worktrees/daedalus/issue-cli-helper/backlog/bugs",
    "~/Projects/tasks/daedalus:~/.daedalus/worktrees/daedalus/issue-cli-helper/.daedalus-folders/daedalus",
    "~/Projects/tasks/daedalus/bugs:~/.daedalus/worktrees/daedalus/issue-cli-helper/backlog/bugs",
]
mask = [
    ".claude/settings.json",
    ".claude/settings.local.json",
    "~/.claude/settings.json",
    "~/.claude/settings.json",
]
network = true
no_worktree = false
