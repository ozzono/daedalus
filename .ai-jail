# ai-jail sandbox configuration
# https://github.com/akitaonrails/ai-jail
# Edit freely. Regenerate with: ai-jail --clean --init

command = [
    "claude",
    "--output-format",
    "json",
    "-p",
    "--dangerously-skip-permissions",
]
rw_maps = [
    "~/Projects/tasks/daedalus/bugs:~/.daedalus/worktrees/daedalus/issue-bug-fix-round4/backlog/bugs",
    "~/Projects/tasks/daedalus:~/.daedalus/worktrees/daedalus/issue-bug-fix-round4/.daedalus-folders/daedalus",
    "~/Projects/tasks/daedalus/bugs:~/.daedalus/worktrees/daedalus/issue-bug-fix-round4.2/backlog/bugs",
    "~/Projects/tasks/daedalus:~/.daedalus/worktrees/daedalus/issue-bug-fix-round4.2/.daedalus-folders/daedalus",
    "~/Projects/tasks/daedalus/bugs:~/.daedalus/worktrees/daedalus/issue-cot-last-write/backlog/bugs",
    "~/Projects/tasks/daedalus:~/.daedalus/worktrees/daedalus/issue-cot-last-write/.daedalus-folders/daedalus",
    "~/Projects/tasks/daedalus/bugs:~/.daedalus/worktrees/daedalus/issue-skip-preflight-arg/backlog/bugs",
    "~/Projects/tasks/daedalus:~/.daedalus/worktrees/daedalus/issue-skip-preflight-arg/.daedalus-folders/daedalus",
    "~/Projects/tasks/daedalus/bugs:~/.daedalus/worktrees/daedalus/issue-skip-preflight-arg/backlog/bugs",
]
mask = [
    ".claude/settings.json",
    ".claude/settings.local.json",
    "~/.claude/settings.json",
    "~/.claude/settings.json",
]
network = true
no_worktree = false
